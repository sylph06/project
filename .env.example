# Copy these values into the web server/PHP environment for production.
KK_APP_ENV=production
KK_DB_HOST=127.0.0.1
KK_DB_NAME=kk
KK_DB_USER=kk_app
KK_DB_PASS=replace-with-a-long-random-password

# Configure these in the PHP/Apache environment before enabling Google sign-in.
# The client secret must never be committed or shared.
KK_GOOGLE_CLIENT_ID=
KK_GOOGLE_CLIENT_SECRET=
KK_GOOGLE_REDIRECT_URI=http://localhost/project/google-callback.php
# Keep false during the pilot. Set true only after member emails are corrected.
KK_GOOGLE_REQUIRE_KK=false

# Optional offline GeoLite2 City database; keep the .mmdb file outside the web root.
KK_GEOIP_DB_PATH=
